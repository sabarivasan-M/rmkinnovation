# Database: sqlite (default, no setup needed) or postgres
DATABASE_URL=sqlite:///./qshield.db
# Example for Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/qshield

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk engine weights (must sum to 1.0)
RISK_WEIGHT_CYBER=0.20
RISK_WEIGHT_BEHAVIOUR=0.20
RISK_WEIGHT_ANOMALY=0.20
RISK_WEIGHT_CRYPTO=0.20
RISK_WEIGHT_QUANTUM=0.20

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ENABLED=true
